# Ars Arcanum root .gitignore — repo holds templates/scripts/docs only.
# Runtime worlds live in ~/Worlds (outside this repo) and are never committed.

# Export and publishing outputs (in case a world folder is staged by accident)
*.pdf
*.epub
*.mobi
*.azw3
*.docx
/04-Exports/
/04-Publishing/

# Runtime world folders
/Worlds/
/00-World-Bible/
/01-Manuscript/
/02-Maps/
/03-Art/

# Editor and IDE noise
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.swn
*~
.#*
\#*#

# Obsidian Vault runtime noise
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/graph.json
.obsidian/indexeddb/

# Operating System noise
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
Thumbs.db
Thumbs.db:encryptable
[Dd]esktop.ini
$RECYCLE.BIN/

# Secrets and credential protection (SEC-02): never commit these even by
# accident. Ars Arcanum itself is offline, but contributors/CI/packaging
# experiments may create them (API keys, signing keys, .env files).
.env
.env.*
*.pem
*.key
*.cert
*.p12
*.pfx
*.secret

# Python and virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/

# Local backup directories and archives
/05-Backups/
*.tar.xz
*.tar.gz
*.zip
*.7z

# Verification artifacts and temporary files
*.bak
*.tmp
*.log
/tmp/
scratch/

# Ars Arcanum Cache and Sync State
.arcanum_cache.json
*.arcanum_cache.json
.sync_state.json
*.sync_state.json
.scriptorium_cache.json
*.scriptorium_cache.json

# Debian packaging build artifacts
debian/.debhelper/
debian/ars-arcanum/
debian/ars-arcanum.substvars
debian/scriptorium/
debian/scriptorium.substvars
debian/files
debian/debhelper-build-stamp

# Build, distribution, and packaging outputs
/dist/
/build/
*.egg-info/
.coverage
coverage.xml
htmlcov/

# Performance benchmark outputs
.benchmarks/

# Python cache in scripts/ (not covered by root __pycache__ rule)
scripts/__pycache__/

# Agent scratch & teamwork logs
.agents/

